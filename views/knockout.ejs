<!doctype html><html><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>Knockout · <%= pool.name %></title><link rel='icon' href='/img/logo.png'/><link rel='stylesheet' href='/style.css?v=20260629poster2'/></head><body class='knockout-page'>
<main class='knockout-app'>
  <nav class='knockout-nav' aria-label='Knockout navigation'>
    <a class='knockout-back' href='/pools/<%= pool.id %>'>← Pool</a>
    <a class='knockout-action' href='/pools/<%= pool.id %>/pronosticos'>Pronósticos</a>
  </nav>
  <section class='knockout-stage' aria-label='World Cup 2026 knockout bracket'>
    <div class='knockout-circle knockout-circle-large' style='--knockout-size:<%= knockoutCircle.size %>'>
      <svg class='knockout-lines' viewBox='0 0 <%= knockoutCircle.size %> <%= knockoutCircle.size %>' aria-hidden='true'>
        <% knockoutCircle.rings.forEach(radius => { %>
          <circle class='knockout-ring <%= radius < 330 ? "knockout-ring-inner" : "" %>' cx='<%= knockoutCircle.size / 2 %>' cy='<%= knockoutCircle.size / 2 %>' r='<%= radius %>'></circle>
        <% }) %>
        <% knockoutCircle.connectors.forEach(connector => { %>
          <line class='knockout-connector <%= connector.active ? "is-active" : "" %>' x1='<%= connector.x1 %>' y1='<%= connector.y1 %>' x2='<%= connector.x2 %>' y2='<%= connector.y2 %>'></line>
        <% }) %>
      </svg>
      <div class='knockout-center knockout-center-large'>
        <span class='knockout-trophy' aria-hidden='true'></span>
      </div>
      <% knockoutCircle.outerTeams.forEach(team => { %>
        <div class='knockout-team <%= team.winner ? "is-winner" : "" %> <%= team.eliminated ? "is-eliminated" : "" %>' style='left:<%= (team.x / knockoutCircle.size) * 100 %>%;top:<%= (team.y / knockoutCircle.size) * 100 %>%' title='<%= team.name %>'>
          <% if (team.logo) { %><img class='hide-on-error' src='<%= team.logo %>' alt=''/><% } else if (team.flag) { %><span class='knockout-flag'><%= team.flag %></span><% } else { %><span><%= team.initials %></span><% } %>
          <% if (team.status === 'finished' && team.score !== null) { %><em><%= team.score %></em><% } %>
        </div>
      <% }) %>
      <% knockoutCircle.winnerSlots.forEach(slot => { %>
        <div class='knockout-slot <%= slot.settled ? "is-settled" : "" %>' style='left:<%= (slot.x / knockoutCircle.size) * 100 %>%;top:<%= (slot.y / knockoutCircle.size) * 100 %>%' title='<%= slot.round %>: <%= slot.name %>'>
          <% if (slot.logo) { %><img class='hide-on-error' src='<%= slot.logo %>' alt=''/><% } else if (slot.settled) { %><span><%= slot.initials %></span><% } %>
        </div>
      <% }) %>
      <div class='knockout-mark' aria-hidden='true'>e9</div>
    </div>
  </section>
</main>
<script src='/app.js' defer></script>
</body></html>
