<!doctype html>
<html>
<head><script src='/theme.js?v=20261008c'></script>
  <meta charset='utf-8'/>
  <meta name='viewport' content='width=device-width,initial-scale=1'/>
  <title><%= pool.name %> · Join Pool</title>
  <meta property='og:title' content='Join pool: <%= pool.name %>' />
  <meta property='og:description' content='You are invited to join "<%= pool.name %>" on LaKiniela.' />
  <meta property='og:type' content='website' />
  <meta property='og:url' content='<%= inviteUrl %>' />
  <meta property='og:image' content='<%= ogImage %>' />
  <meta name='twitter:card' content='summary_large_image' />
  <meta name='twitter:title' content='Join pool: <%= pool.name %>' />
  <meta name='twitter:description' content='You are invited to join "<%= pool.name %>" on LaKiniela.' />
  <meta name='twitter:image' content='<%= ogImage %>' />
  <link rel='icon' href='<%= logoPath || "/img/lakiniela-mark.png" %>'/>
  <link rel='stylesheet' href='/style.css?v=20260309invite2'/>
<link rel='stylesheet' href='/redesign.css?v=20261008c'/><link rel='stylesheet' href='/theme.css?v=20261008c'/></head>
<body class='auth'>
  <div class='card auth-card'>
    <img class='brand-logo big' src='<%= logoPath || "/img/lakiniela-mark.png" %>' alt='pool logo'/>
    <h1><%= pool.name %></h1>
    <p>You're invited to join this pool.</p>
    <% if (user) { %>
      <form method='post' action='/invite/<%= pool.code %>'>
        <input type='hidden' name='_csrf' value='<%= csrfToken %>'/>
        <button type='submit'>Join pool</button>
      </form>
    <% } else { %>
      <a href='/login'><button type='button'>Login to join</button></a>
      <a href='/register'><button type='button'>Create account</button></a>
    <% } %>
  </div>
</body>
</html>
