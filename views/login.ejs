<!doctype html><html><head><script src='/theme.js?v=20261008c'></script><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>lakiniela Login</title><link rel='icon' href='/img/lakiniela-mark.png'/><link rel='stylesheet' href='/style.css?v=3'/><link rel='stylesheet' href='/redesign.css?v=20261008c'/><link rel='stylesheet' href='/theme.css?v=20261008c'/></head><body class='auth'>
<div class='card auth-card'><img class='brand-logo big' src='/img/lakiniela-mark.png' alt='LaKiniela Liga MX logo'/>
<% if (error) { %><p class='error'><%= error %></p><% } %>
<form method='post' action='/login'>
<input type='hidden' name='_csrf' value='<%= csrfToken %>'/>
<input name='username' placeholder='Username'/><input type='password' name='password' placeholder='Password'/><button>Login</button>
</form><a href='/register'>Create account</a></div></body></html>
