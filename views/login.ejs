<!doctype html><html><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>lakiniela Login</title><link rel='icon' href='/img/world-cup-2026.png?v=official-20260611'/><link rel='stylesheet' href='/style.css?v=3'/></head><body class='auth'>
<div class='card auth-card'><img class='brand-logo big' src='/img/world-cup-2026.png?v=official-20260611' alt='FIFA World Cup 2026 logo'/>
<% if (error) { %><p class='error'><%= error %></p><% } %>
<form method='post' action='/login'>
<input type='hidden' name='_csrf' value='<%= csrfToken %>'/>
<input name='username' placeholder='Username'/><input type='password' name='password' placeholder='Password'/><button>Login</button>
</form><a href='/register'>Create account</a></div></body></html>
