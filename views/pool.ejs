<!doctype html><html lang='es'><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title><%= pool.name %> · LaKiniela</title><link rel='icon' href='/img/logo.png'/><link rel='stylesheet' href='/style.css?v=20260803mobile-standings'/></head><body class='has-mobile-nav'>
<header class='top'><a href='/dashboard'>← Dashboard</a><div class='brand'><img class='brand-logo' src='<%= competitionLogo(pool.competition_type) %>' alt='pool logo'/><h1><%= pool.name %></h1></div><span class='badge'>Code: <%= pool.code %></span></header>
<main class='grid two'>
<section class='card' id='standings-card'>
<div class='standings-head'>
  <div>
    <p class='eyebrow'>TABLA DE PUNTOS</p>
    <h3>Clasificación general<% if (pool.competition_type === 'liga_mx') { %> · Liga MX<% } %></h3>
    <small class='standings-scope'><%= pool.competition_type === 'liga_mx' ? 'Puntos acumulados de todo el torneo' : 'Puntos acumulados de la competencia' %></small>
  </div>
  <div class='inline standings-actions'>
    <% if (canViewOthersPicks) { %>
      <a class='button-link' href='/pools/<%= pool.id %>/pronosticos'>Pronósticos</a>
    <% } %>
    <% if (knockoutCircle) { %>
      <a class='button-link' href='/pools/<%= pool.id %>/knockout'>Knockout bracket</a>
    <% } %>
    <button type='button' id='share-standings'>Share snapshot</button>
  </div>
</div>
<div class='standings-columns' aria-hidden='true'><span>Posición · Participante</span><span>Puntos</span></div>
<ol class='standings' id='standings-list'>
<% standings.forEach((s, i) => { %>
<li class='<%= i === 0 ? "standing-top" : "" %>' <%= i === 0 ? "style='background:linear-gradient(90deg,rgba(255,215,0,.18),rgba(255,215,0,.04));border:1px solid rgba(255,215,0,.45);border-radius:10px;padding:10px 12px;margin:2px 0 10px;'" : "" %>>
  <span>
    <% if (canViewOthersPicks) { %>
      <a href='/pools/<%= pool.id %>/users/<%= s.id %>/picks'><%= s.name %></a>
    <% } else { %>
      <span class='standing-name'><%= s.name %></span>
    <% } %>
    <% if (i === 0 && !poolFinished) { %><span class='leader-badge' style='display:inline-flex;align-items:center;gap:4px;margin-left:8px;font-size:.72rem;padding:2px 8px;border-radius:999px;border:1px solid rgba(255,215,0,.55);background:rgba(255,215,0,.12);color:#ffe58a;'>👑 Top</span><% } %>
    <small class='standing-stats'>
      Aciertos <%= s.accuracy_pct === null ? '—' : `${s.accuracy_pct}%` %>
      · Exactos <%= s.exact_pct === null ? '—' : `${s.exact_pct}%` %>
      <% if (s.finished_picks) { %>
        (<%= s.correct_picks %>/<%= s.finished_picks %> · <%= s.exact_picks %>/<%= s.finished_picks %>)
      <% } %>
    </small>
  </span>
  <strong><%= s.points %> pts<% if (poolFinished && i === 0) { %> <span aria-label='Winner'>👑</span><% } %></strong>
</li>
<% }) %>
</ol>
<% if (matchdayStandings) { %>
<div class='matchday-leaderboard'>
  <div class='section-heading'>
    <div>
      <p class='eyebrow'>CLASIFICACIÓN DE JORNADA</p>
      <h3><%= matchdayStandings.label %></h3>
    </div>
    <span class='round-progress'><%= matchdayStandings.finishedMatches %>/<%= matchdayStandings.totalMatches %> finales</span>
  </div>
  <% if (matchdayStandings.complete && matchdayStandings.winnerNames.length) { %>
    <div class='weekly-winner'>🏆 Ganador<%= matchdayStandings.winnerNames.length > 1 ? 'es' : '' %>: <strong><%= matchdayStandings.winnerNames.join(', ') %></strong></div>
  <% } %>
  <ol class='round-standings'>
    <% matchdayStandings.rows.forEach((s, index) => { %>
      <li>
        <span class='round-rank'>#<%= index + 1 %></span>
        <span class='round-player'><strong><%= s.name %></strong><small>General #<%= s.overall_rank %></small></span>
        <span class='rank-movement <%= s.rank_change > 0 ? "rank-up" : s.rank_change < 0 ? "rank-down" : "" %>'>
          <%= s.rank_change > 0 ? `↑${s.rank_change}` : s.rank_change < 0 ? `↓${Math.abs(s.rank_change)}` : '—' %>
        </span>
        <strong><%= s.matchday_points %> pts</strong>
      </li>
    <% }) %>
  </ol>
</div>
<% } %>
<% const progressionCharts = [
  {
    title: 'Points Progression',
    subtitle: 'Days since start',
    xLabel: 'Days since tournament start',
    data: pointsProgression,
    empty: 'No finished matches with scored picks yet.',
  },
]; %>
<% if (roundOf32PointsProgression) {
  progressionCharts.push({
    title: 'Ronda de 32 Points Progression',
    subtitle: 'Days since R32 start',
    xLabel: 'Days since Ronda de 32 start',
    data: roundOf32PointsProgression,
    empty: 'No finished Ronda de 32 matches with scored picks yet.',
  });
} %>
<% progressionCharts.forEach((progressionChart) => { const chartData = progressionChart.data; %>
<div class='trend-card'>
  <div class='trend-head'>
    <h3><%= progressionChart.title %></h3>
    <span><%= progressionChart.subtitle %></span>
  </div>
  <% if (chartData && chartData.hasData) { %>
    <% const chart = { w: 720, h: 300, left: 54, right: 18, top: 18, bottom: 48 }; %>
    <% const plotW = chart.w - chart.left - chart.right; const plotH = chart.h - chart.top - chart.bottom; %>
    <% const xFor = (day) => chart.left + ((Number(day) || 0) / chartData.maxDay) * plotW; %>
    <% const yFor = (value) => chart.top + plotH - ((Number(value) || 0) / chartData.maxPoints) * plotH; %>
    <div class='trend-chart-wrap'>
      <svg class='trend-chart' viewBox='0 0 <%= chart.w %> <%= chart.h %>' role='img' aria-label='Points progression by user'>
        <rect class='trend-plot-bg' x='<%= chart.left %>' y='<%= chart.top %>' width='<%= plotW %>' height='<%= plotH %>' rx='10'></rect>
        <% chartData.yTicks.forEach(tick => { const y = yFor(tick); %>
          <line class='trend-grid' x1='<%= chart.left %>' y1='<%= y %>' x2='<%= chart.w - chart.right %>' y2='<%= y %>'></line>
          <text class='trend-tick trend-y-tick' x='<%= chart.left - 10 %>' y='<%= y + 4 %>'><%= tick %></text>
        <% }) %>
        <% chartData.xTicks.forEach(tick => { const x = xFor(tick); %>
          <line class='trend-grid trend-grid-vertical' x1='<%= x %>' y1='<%= chart.top %>' x2='<%= x %>' y2='<%= chart.top + plotH %>'></line>
          <text class='trend-tick' x='<%= x %>' y='<%= chart.h - 24 %>'><%= tick %></text>
        <% }) %>
        <line class='trend-axis' x1='<%= chart.left %>' y1='<%= chart.top + plotH %>' x2='<%= chart.w - chart.right %>' y2='<%= chart.top + plotH %>'></line>
        <line class='trend-axis' x1='<%= chart.left %>' y1='<%= chart.top %>' x2='<%= chart.left %>' y2='<%= chart.top + plotH %>'></line>
        <text class='trend-axis-label' x='<%= chart.left + (plotW / 2) %>' y='<%= chart.h - 6 %>'><%= progressionChart.xLabel %></text>
        <text class='trend-axis-label trend-y-label' x='16' y='<%= chart.top + (plotH / 2) %>' transform='rotate(-90 16 <%= chart.top + (plotH / 2) %>)'>Points</text>
        <% chartData.users.forEach(user => { %>
          <% const polyline = user.points.map(point => `${xFor(point.day).toFixed(1)},${yFor(point.value).toFixed(1)}`).join(' '); %>
          <polyline class='trend-line' points='<%= polyline %>' style='stroke:<%= user.color %>'></polyline>
          <% const lastPoint = user.points[user.points.length - 1]; %>
          <circle class='trend-dot' cx='<%= xFor(lastPoint.day) %>' cy='<%= yFor(lastPoint.value) %>' r='4' style='fill:<%= user.color %>'></circle>
        <% }) %>
      </svg>
    </div>
    <div class='trend-legend'>
      <% chartData.users.forEach(user => { %>
        <span><i style='background:<%= user.color %>'></i><strong><%= user.name %></strong><em><%= user.total %> pts</em></span>
      <% }) %>
    </div>
  <% } else { %>
    <p class='muted trend-empty'><%= progressionChart.empty %></p>
  <% } %>
</div>
<% }) %>
</section>
<section class='card predictions-card' id='predicciones'>
<div class='section-heading prediction-section-head'>
  <div><p class='eyebrow'>TUS MARCADORES</p><h2>Pronósticos</h2></div>
  <% if (matches.length) { %><span class='completion-pill' id='completion-count'>0/<%= matches.length %> completos</span><% } %>
</div>
<p class='muted'>3 pts por resultado correcto · 5 pts por marcador exacto. Se cierran 15 minutos antes.</p>
<% if (predictionRounds.length > 1) { %>
  <nav class='round-tabs' aria-label='Selecciona jornada'>
    <% predictionRounds.forEach((round) => { %>
      <a class='<%= round.key === selectedPredictionRound.key ? "is-active" : "" %>' href='/pools/<%= pool.id %>?round=<%= encodeURIComponent(round.key) %>#predicciones'><%= round.label %></a>
    <% }) %>
  </nav>
<% } %>
<div class='invite-row'>
  <input class='invite-link' id='invite-link' readonly value='<%= inviteLink %>' />
  <button type='button' id='copy-invite'>Copy invite</button>
</div>
<div class='list prediction-list' id='prediction-list'>
<% if (matches.length) { %>
<% matches.forEach(m => { const p = predByMatch.get(m.id); const lockMs = new Date(m.kickoff_at).getTime() - (15 * 60 * 1000); const locked = m.status==='finished' || nowMs >= lockMs; %>
<div class='prediction <%= locked ? "is-locked" : "" %>' data-match='<%= m.id %>'>
<div class='prediction-head'>
  <% if ((m.status==='live' || m.status==='finished') && m.home_score !== null && m.away_score !== null) { %>
    <div class='fixture-line'>
      <span class='score-line'>
        <% if (m.status==='finished') { %><span class='final-score-label'>Final score</span><% } %>
        <strong><%= m.home_score %>-<%= m.away_score %></strong>
        <% if (m.status==='finished' && m.home_penalty_score !== null && m.away_penalty_score !== null) { %>
          <span class='final-score-label'>Pens <%= m.home_penalty_score %>-<%= m.away_penalty_score %></span>
        <% } %>
        <% if (m.status==='live') { %><span class='live-dot' title='Live now'></span><% } %>
      </span>
    </div>
  <% } %>
</div>
<div class='score-inputs'>
  <div class='score-col'>
    <div class='score-input-wrap'>
      <img class='team-logo score-box-logo hide-on-error' src='<%= m.home_logo || "" %>' alt=''/>
      <div class='score-control'><button type='button' class='score-step' data-delta='-1' aria-label='Restar gol a <%= m.home_team %>' <%= locked ? 'disabled' : '' %>>−</button><input type='number' min='0' max='30' inputmode='numeric' class='ph' value='<%= p ? p.pred_home : "" %>' <%= locked ? 'disabled' : '' %> /><button type='button' class='score-step' data-delta='1' aria-label='Sumar gol a <%= m.home_team %>' <%= locked ? 'disabled' : '' %>>+</button></div>
    </div>
    <label class='team-label team-label-below'><span><%= m.home_team %></span></label>
  </div>
  <div class='score-sep'>-</div>
  <div class='score-col'>
    <div class='score-input-wrap score-input-wrap-right'>
      <img class='team-logo score-box-logo hide-on-error' src='<%= m.away_logo || "" %>' alt=''/>
      <div class='score-control'><button type='button' class='score-step' data-delta='-1' aria-label='Restar gol a <%= m.away_team %>' <%= locked ? 'disabled' : '' %>>−</button><input type='number' min='0' max='30' inputmode='numeric' class='pa' value='<%= p ? p.pred_away : "" %>' <%= locked ? 'disabled' : '' %> /><button type='button' class='score-step' data-delta='1' aria-label='Sumar gol a <%= m.away_team %>' <%= locked ? 'disabled' : '' %>>+</button></div>
    </div>
    <label class='team-label team-label-right team-label-below'><span><%= m.away_team %></span></label>
  </div>
</div>
<div class='inline prediction-status'>
<% if (m.status==='live') { %><span class='badge'>En vivo</span><% } %>
<% if (m.status==='finished') { %><span class='badge'>Final</span><% } %>
<% if (locked && m.status!=='finished') { %><span class='badge'>Cerrado</span><% } %>
</div>
<small class='fixture-meta'><%= m.kickoff_local || m.kickoff_at %></small>
</div>
<% }) %>
<% } else { %>
  <p class='muted'>No hay partidos pendientes para registrar pronósticos.</p>
<% } %>
</div>
<% if (matches.some(m => { const lockMs = new Date(m.kickoff_at).getTime() - (15 * 60 * 1000); return m.status !== 'finished' && nowMs < lockMs; })) { %>
  <div class='save-all-bar'>
    <div><strong id='save-status'>Completa tus marcadores</strong><small id='save-detail'>Se guarda solo <%= selectedPredictionRound.label || "esta jornada" %></small></div>
    <button type='button' id='save-all'>Guardar jornada</button>
  </div>
<% } %>
</section>
</main>
<nav class='mobile-nav' aria-label='Navegación de quiniela'>
  <a href='/dashboard'><span>⌂</span>Inicio</a>
  <a class='is-active' href='#predicciones'><span>✓</span>Pronósticos</a>
  <a href='#standings-card'><span>🏆</span>Tabla</a>
</nav>
<script src='/app.js' defer></script>
<script src='/vendor/html2canvas.min.js' defer></script>
<script nonce="<%= cspNonce %>">
const csrfToken = <%- safeJson(csrfToken) %>;
const snapshotPoolName = <%- safeJson(pool.name) %>;
const snapshotPoolCode = <%- safeJson(pool.code) %>;
const snapshotLogo = <%- safeJson(competitionLogo(pool.competition_type)) %>;
const editableRows = Array.from(document.querySelectorAll('.prediction:not(.is-locked)'));
const saveAllBtn = document.getElementById('save-all');
const saveStatus = document.getElementById('save-status');
const saveDetail = document.getElementById('save-detail');
const completionCount = document.getElementById('completion-count');

function updateCompletion() {
  const complete = editableRows.filter((row) => row.querySelector('.ph').value !== '' && row.querySelector('.pa').value !== '').length;
  if (completionCount) completionCount.textContent = `${complete}/${editableRows.length} completos`;
  if (saveAllBtn) saveAllBtn.disabled = complete !== editableRows.length;
  if (saveStatus) saveStatus.textContent = complete === editableRows.length ? 'Listo para guardar' : `${editableRows.length - complete} pendiente${editableRows.length - complete === 1 ? '' : 's'}`;
}

document.querySelectorAll('.score-step').forEach((button) => {
  button.addEventListener('click', () => {
    const input = button.parentElement.querySelector('input');
    const next = Math.max(0, Math.min(30, Number(input.value || 0) + Number(button.dataset.delta || 0)));
    input.value = String(next);
    input.dispatchEvent(new Event('input', { bubbles: true }));
  });
});
editableRows.forEach((row) => row.querySelectorAll('input').forEach((input) => input.addEventListener('input', updateCompletion)));
updateCompletion();

if (saveAllBtn) {
  saveAllBtn.addEventListener('click', async () => {
    const predictions = editableRows.map((row) => ({
      match_id: Number(row.dataset.match),
      pred_home: row.querySelector('.ph').value,
      pred_away: row.querySelector('.pa').value,
    }));
    if (predictions.some((pick) => pick.pred_home === '' || pick.pred_away === '')) {
      alert('Completa todos los marcadores antes de guardar.');
      return;
    }
    saveAllBtn.disabled = true;
    saveAllBtn.textContent = 'Guardando…';
    try {
      const response = await fetch(`/pools/<%= pool.id %>/predictions`, {
        method: 'POST',
        headers: {'Content-Type':'application/json','x-csrf-token':csrfToken},
        body: JSON.stringify({ predictions }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'No se pudieron guardar los pronósticos.');
      saveAllBtn.textContent = 'Guardados ✓';
      if (saveStatus) saveStatus.textContent = 'Pronósticos guardados';
      if (saveDetail) saveDetail.textContent = `${result.saved} marcadores actualizados`;
      setTimeout(() => {
        saveAllBtn.textContent = 'Guardar jornada';
        saveAllBtn.disabled = false;
      }, 1600);
    } catch (error) {
      alert(error.message);
      saveAllBtn.textContent = 'Guardar jornada';
      saveAllBtn.disabled = false;
    }
  });
}

const copyBtn = document.getElementById('copy-invite');
const inviteInput = document.getElementById('invite-link');
if (copyBtn && inviteInput) {
  copyBtn.onclick = async () => {
    try {
      await navigator.clipboard.writeText(inviteInput.value);
      copyBtn.textContent = 'Copied';
      setTimeout(() => (copyBtn.textContent = 'Copy invite'), 1200);
    } catch {
      inviteInput.select();
      document.execCommand('copy');
      copyBtn.textContent = 'Copied';
      setTimeout(() => (copyBtn.textContent = 'Copy invite'), 1200);
    }
  };
}

const shareBtn = document.getElementById('share-standings');
const standingsList = document.getElementById('standings-list');
if (shareBtn && standingsList) {
  shareBtn.onclick = async () => {
    if (!window.html2canvas) {
      alert('Snapshot tool not loaded yet. Please try again.');
      return;
    }

    const original = shareBtn.textContent;
    shareBtn.disabled = true;
    shareBtn.textContent = 'Preparing...';

    try {
      const rows = Array.from(standingsList.querySelectorAll('li')).map((li, i) => {
        const name = li.querySelector('a, .standing-name')?.textContent?.trim() || 'Player';
        const stats = li.querySelector('.standing-stats')?.textContent?.replace(/\s+/g, ' ').trim() || '';
        const pointsRaw = li.querySelector('strong')?.textContent?.replace('👑', '').trim() || '0 pts';
        return { rank: i + 1, name, stats, points: pointsRaw };
      });

      const element = (tag, className, text) => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      };
      const shot = element('div', 'standings-snapshot');
      shot.className = 'standings-snapshot';
      const head = element('div', 'standings-snapshot-head');
      const heading = element('div');
      heading.append(element('h2', '', 'Tabla de puntos'));
      heading.append(element('p', '', `${snapshotPoolName} · Code ${snapshotPoolCode}`));
      const logo = element('img');
      logo.src = snapshotLogo;
      logo.alt = 'pool';
      head.append(heading, logo);
      shot.append(head);

      const list = element('ol');
      rows.forEach((row, index) => {
        const item = element('li', index === 0 ? 'is-top' : '');
        const left = element('span', 'left');
        left.append(element('span', 'rank', `#${row.rank}`));
        const player = element('span', 'snapshot-player');
        player.append(element('strong', '', row.name), element('small', '', row.stats));
        left.append(player);
        item.append(left, element('strong', '', `${row.points}${index === 0 ? ' 👑' : ''}`));
        list.append(item);
      });
      shot.append(list);
      document.body.appendChild(shot);

      const canvas = await window.html2canvas(shot, {
        backgroundColor: null,
        scale: Math.min(window.devicePixelRatio || 2, 3),
        useCORS: true,
      });
      shot.remove();

      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
      if (!blob) throw new Error('snapshot_failed');

      const fileName = `lakiniela-standings-${snapshotPoolCode}.png`;
      const file = new File([blob], fileName, { type: 'image/png' });

      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({
          files: [file],
          title: `${snapshotPoolName} standings`,
          text: `${snapshotPoolName} standings`,
        });
      } else {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1500);
      }

      shareBtn.textContent = 'Shared';
      setTimeout(() => (shareBtn.textContent = original), 1400);
    } catch (e) {
      shareBtn.textContent = original;
      alert('Could not share snapshot right now.');
    } finally {
      shareBtn.disabled = false;
    }
  };
}
</script>
</body></html>
