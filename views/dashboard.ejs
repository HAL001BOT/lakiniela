<!doctype html>
<html lang='es'>
<head>
  <meta charset='utf-8'/>
  <meta name='viewport' content='width=device-width,initial-scale=1'/>
  <title>Inicio · LaKiniela</title>
  <link rel='icon' href='/img/logo.png'/>
  <link rel='stylesheet' href='/style.css?v=20260725matchday1'/>
</head>
<body class='has-mobile-nav'>
<header class='top dashboard-top'>
  <div class='brand'><img class='brand-logo' src='/img/logo.png' alt='LaKiniela'/></div>
  <div class='inline desktop-actions'>
    <a class='button-link button-secondary' href='/account/password'>Perfil</a>
    <% if (isAdmin) { %><a class='button-link button-secondary' href='/admin/users'>Admin</a><% } %>
    <form method='post' action='/logout'><input type='hidden' name='_csrf' value='<%= csrfToken %>'/><button class='button-secondary'>Salir</button></form>
  </div>
</header>

<main class='grid dashboard-grid' id='inicio'>
  <section class='dashboard-hero'>
    <p class='eyebrow'>TU JORNADA</p>
    <h1>Hola, <%= user.name %></h1>
    <% const actionPool = pools.find(p => p.incomplete_count > 0); %>
    <% if (actionPool) { %>
      <div class='next-action-card'>
        <div>
          <span class='action-kicker'><%= competitionLabel(actionPool.competition_type) %> · <%= actionPool.active_round_label || 'Próxima jornada' %></span>
          <h2><%= actionPool.incomplete_count %> pronóstico<%= actionPool.incomplete_count === 1 ? '' : 's' %> pendiente<%= actionPool.incomplete_count === 1 ? '' : 's' %></h2>
          <p>Se cierran <%= actionPool.next_lock_local %> · <strong><%= actionPool.name %></strong></p>
        </div>
        <a class='button-link action-button' href='/pools/<%= actionPool.id %>#predicciones'>Completar pronósticos</a>
      </div>
    <% } else if (pools.length) { %>
      <div class='next-action-card next-action-complete'>
        <div>
          <span class='action-kicker'>TODO LISTO</span>
          <h2>Tus pronósticos están al día</h2>
          <p>Regresa cuando se abra la próxima jornada.</p>
        </div>
        <span class='action-check' aria-hidden='true'>✓</span>
      </div>
    <% } else { %>
      <div class='next-action-card'>
        <div>
          <span class='action-kicker'>EMPIEZA A JUGAR</span>
          <h2>Crea o únete a tu primera quiniela</h2>
          <p>Invita amigos, pronostica marcadores y compite cada jornada.</p>
        </div>
      </div>
    <% } %>
  </section>

  <section class='card quick-actions'>
    <details <%= pools.length ? '' : 'open' %>>
      <summary>Crear o unirme a una quiniela</summary>
      <div class='quick-action-forms'>
        <form method='post' action='/pools/create' class='action-form'>
          <input type='hidden' name='_csrf' value='<%= csrfToken %>'/>
          <label>Nombre<input name='name' placeholder='Los Invencibles' required/></label>
          <label>Competencia<select name='competition_type'><option value='liga_mx'>Liga MX</option><option value='champions_league'>Champions League</option><option value='world_cup_2026'>Mundial 2026</option></select></label>
          <button>Crear quiniela</button>
        </form>
        <form method='post' action='/pools/join' class='action-form join-form'>
          <input type='hidden' name='_csrf' value='<%= csrfToken %>'/>
          <label>Código de invitación<input name='code' placeholder='A1B2C3' required/></label>
          <button>Unirme</button>
        </form>
      </div>
    </details>
  </section>

  <section class='card' id='quinielas'>
    <div class='section-heading'>
      <div><p class='eyebrow'>MIS COMPETENCIAS</p><h2>Mis quinielas</h2></div>
      <span class='section-count'><%= pools.length %></span>
    </div>
    <div class='pool-grid'>
      <% pools.forEach(p => { %>
        <a class='pool-summary-card' href='/pools/<%= p.id %>'>
          <div class='pool-summary-head'>
            <img class='pool-item-logo' src='<%= competitionLogo(p.competition_type) %>' alt=''/>
            <div><strong><%= p.name %></strong><small><%= competitionLabel(p.competition_type) %> · <%= p.active_round_label || 'Temporada' %></small></div>
            <span class='pool-chevron'>›</span>
          </div>
          <div class='pool-summary-stats'>
            <span><small>Posición</small><strong><%= p.my_rank ? `#${p.my_rank}` : '—' %></strong></span>
            <span><small>Puntos</small><strong><%= p.my_points %></strong></span>
            <span><small>Jornadas ganadas</small><strong><%= p.my_matchday_wins %></strong></span>
            <span><small>Pendientes</small><strong class='<%= p.incomplete_count ? "attention" : "" %>'><%= p.incomplete_count %></strong></span>
          </div>
          <% if (p.pool_finished && p.winner_name) { %><span class='pool-winner'>Ganador: <%= p.winner_name %> 👑</span><% } %>
        </a>
      <% }) %>
      <% if (!pools.length) { %><p class='muted'>Todavía no tienes quinielas.</p><% } %>
    </div>
  </section>

  <section class='card schedule-card'>
    <div class='section-heading'><div><p class='eyebrow'>PRÓXIMOS PARTIDOS</p><h2>Calendario</h2></div></div>
    <div class='competition-tabs'>
      <details open>
        <summary>Liga MX<% if (jornadaNumber) { %> · Jornada <%= jornadaNumber %><% } %> <span><%= nextMatches.length %></span></summary>
        <% nextMatches.forEach(m => { %><div class='match-line'><div class='teams-col'><div class='team-row'><img class='team-logo hide-on-error' src='<%= m.home_logo || "" %>' alt=''/><span><%= m.home_team %></span></div><div class='team-row'><img class='team-logo hide-on-error' src='<%= m.away_logo || "" %>' alt=''/><span><%= m.away_team %></span></div></div><small><%= m.kickoff_local || m.kickoff_at %><% if ((m.status==='live' || m.status==='finished') && m.home_score !== null) { %> · <%= m.home_score %>-<%= m.away_score %><% } %></small></div><% }) %>
        <% if (!nextMatches.length) { %><p class='muted'>Sin partidos programados.</p><% } %>
      </details>
      <details>
        <summary>Champions League <span><%= championsMatches.length %></span></summary>
        <% championsMatches.forEach(m => { %><div class='match-line'><div class='teams-col'><div class='team-row'><img class='team-logo hide-on-error' src='<%= m.home_logo || "" %>' alt=''/><span><%= m.home_team %></span></div><div class='team-row'><img class='team-logo hide-on-error' src='<%= m.away_logo || "" %>' alt=''/><span><%= m.away_team %></span></div></div><small><%= m.kickoff_local || m.kickoff_at %></small></div><% }) %>
        <% if (!championsMatches.length) { %><p class='muted'>Sin partidos programados.</p><% } %>
      </details>
      <details>
        <summary>Mundial 2026 <span><%= worldCupMatches.length %></span></summary>
        <% worldCupMatches.forEach(m => { %><div class='match-line'><div class='teams-col'><div class='team-row'><img class='team-logo hide-on-error' src='<%= m.home_logo || "" %>' alt=''/><span><%= m.home_team %></span></div><div class='team-row'><img class='team-logo hide-on-error' src='<%= m.away_logo || "" %>' alt=''/><span><%= m.away_team %></span></div></div><small><%= m.kickoff_local || m.kickoff_at %></small></div><% }) %>
        <% if (!worldCupMatches.length) { %><p class='muted'>Sin partidos programados.</p><% } %>
      </details>
    </div>
  </section>
</main>

<nav class='mobile-nav' aria-label='Navegación principal'>
  <a class='is-active' href='#inicio'><span>⌂</span>Inicio</a>
  <a href='#quinielas'><span>⚽</span>Quinielas</a>
  <a href='/account/password'><span>●</span>Perfil</a>
</nav>
<script src='/app.js' defer></script>
</body>
</html>
